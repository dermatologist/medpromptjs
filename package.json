{
  "name": "medpromptjs",
  "version": "0.5.5",
  "description": "A library of langchain base classes for building medical applications.",
  "license": "Apache-2.0",
  "author": "Bell Eapen",
  "main": "dist/index.js",
  "module": "dist/medpromptjs.mjs",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/medpromptjs.esm.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "analyze": "size-limit --why",
    "build": "dts build --target node",
    "lint": "dts lint --fix",
    "prepare": "dts build --target node",
    "size": "size-limit",
    "start": "dts watch --target node",
    "test": "dts test --coverage --verbose --testPathIgnorePatterns=./test/e2e/*",
    "e2e": "dts test --verbose ./test/e2e --detectOpenHandles",
    "docs": "typedoc --exclude src/tool.ts --html docs src"
  },
  "husky": {
    "hooks": {
      "pre-commit": "dts lint"
    }
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=24"
  },
  "size-limit": [
    {
      "path": "dist/medpromptjs.cjs.production.min.js",
      "limit": "10 KB"
    },
    {
      "path": "dist/medpromptjs.esm.js",
      "limit": "10 KB"
    }
  ],
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/plugin-syntax-typescript": "^7.29.7",
    "@babel/preset-env": "^7.29.14",
    "@size-limit/preset-small-lib": "^11.1.2",
    "@tsconfig/recommended": "^1.0.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/supertest": "^6.0.2",
    "dts-cli": "^2.0.5",
    "google-auth-library": "^9.7.0",
    "husky": "^9.1.7",
    "size-limit": "^11.1.2",
    "supertest": "^7.1.0",
    "ts-mockito": "^2.6.1",
    "tslib": "^2.8.0",
    "typedoc": "^0.27.6",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@langchain/community": "^1.0.0",
    "@langchain/core": "^1.0.0",
    "cors": "^2.8",
    "dotenv": "^16",
    "express": "^5.1",
    "langchain": "^1.0.0",
    "reflect-metadata": "^0.2",
    "tslog": "^4.9",
    "tsyringe": "^4.10"
  }
}