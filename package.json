{
  "name": "medpromptjs",
  "version": "0.6.1",
  "description": "A library of langchain base classes for building medical applications.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dermatologist/medpromptjs.git"
  },
  "license": "Apache-2.0",
  "author": "Bell Eapen",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --fix",
    "prepare": "npm run build",
    "test": "jest --coverage --verbose --testPathIgnorePatterns=./test/e2e/*",
    "e2e": "jest --verbose ./test/e2e --detectOpenHandles",
    "docs": "typedoc --exclude src/tool.ts --out docs src"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint"
    }
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@babel/preset-typescript": "^7.29.7",
    "@tsconfig/recommended": "^1.0.14",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^7.2.1",
    "babel-jest": "^30.5.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "google-auth-library": "^11.3.4",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.2.6",
    "ts-mockito": "^2.6.1",
    "tslib": "^2.9.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "dependencies": {
    "@langchain/classic": "^1.0.62",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.5.0",
    "@langchain/textsplitters": "^1.0.2",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "langchain": "^1.6.7",
    "reflect-metadata": "^0.2.2",
    "tslog": "^5.5.0",
    "tsyringe": "^4.10.0"
  }
}
